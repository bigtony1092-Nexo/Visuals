{
  "method_id": "ar1-linearity",
  "name": "AR1 linearity across the Colorado loading series",
  "version": "1.0.0",
  "created_by": "bigtony1092",
  "created_at": "2026-10-16T08:00:00Z",
  "notes": "Tests whether ar1 holds across a 50-fold on-column range, instead of assuming it. Regress log10(ar1_sum) on log10(amount) per ion; slope zero means invariant, a breakpoint marks the top of the linear range. Run the precursor-intensity control first: if precursor intensity does not rise with roughly unit slope against load, the loading series is not doing what it says. See docs/ar1-linearity.md.",
  "inputs": {
