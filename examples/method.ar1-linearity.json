    "consensus_db": "F:/ARiA/consensus/ARiA_Consensus.db",
    "raw_dir": "E:/Colorado_search_tdc",
    "detect_vendor_from_files": true,
    "manual_overrides": [
      {
        "match": "*/sonar/*",
        "set": {
          "drift_kind": "quad_window"
        }
      }
    ]
  },
  "selection": {
